# Plain HTTP on :80. TLS is expected to be terminated by an upstream
# reverse proxy / load balancer / ingress, not by this container.
#
# Unlike jinear-app (a client-rendered SPA), this is a statically exported site:
# every route has its own pre-rendered HTML, so there is NO SPA fallback to
# index.html; unknown paths return the real 404 page.

{
    # The /relay proxy below forwards X-Forwarded-For to PostHog for GeoIP. Trust
    # the upstream TLS terminator's header, or every event gets its address.
    servers {
        trusted_proxies static private_ranges
    }
}

:80 {
    root * /srv
    encode zstd gzip

    # Next emits content-hashed assets under /_next/static, so cache forever.
    @assets path /_next/static/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # HTML must revalidate so a redeploy is picked up immediately.
    @html path / *.html */
    header @html Cache-Control "no-cache"

    # Legacy bookmark: the old jinear.co/home was the app's entry point, which now
    # lives at app.jinear.co. 301 so bookmarks/search engines update permanently.
    @home path /home /home/
    redir @home https://app.jinear.co 301

    # www → apex. Both hosts served identical HTML with 200s, which inflates the
    # "pages with identical titles" count in search consoles even though every page
    # already declares a canonical pointing at the apex.
    # NOTE: only fires if the upstream TLS terminator preserves the Host header.
    @www host www.jinear.co
    redir @www https://jinear.co{uri} 301

    # `trailingSlash: true` makes /pricing/ the canonical URL, but try_files below
    # would also serve /pricing directly (200, not a redirect), i.e. the same page at
    # two URLs. Redirect the bare form to the slashed one. `not path *.*` keeps
    # static files (/og.png, /sitemap.xml, /llms.txt, ...) out of this.
    @needs_slash {
        not path /
        not path */
        not path *.*
        file {path}/index.html
    }
    redir @needs_slash {path}/ 301

    # First-party PostHog proxy, so ad blockers that drop *.posthog.com requests
    # still let analytics through. Lives here, not in jinear-app's Caddyfile,
    # because this site only runs on the hosted service: self-hosted app images
    # never proxy to Jinear's PostHog. The hosted app (app.jinear.co) reaches it
    # cross-origin through VITE_POSTHOG_HOST, so PostHog's own CORS headers are
    # kept. The asset routes must come before the catch-all.
    handle_path /relay/static/* {
        rewrite * /static{path}
        reverse_proxy https://us-assets.i.posthog.com:443 {
            header_up Host us-assets.i.posthog.com
            header_up -Cookie
            header_up -Authorization
        }
    }
    handle_path /relay/array/* {
        rewrite * /array{path}
        reverse_proxy https://us-assets.i.posthog.com:443 {
            header_up Host us-assets.i.posthog.com
            header_up -Cookie
            header_up -Authorization
        }
    }
    handle_path /relay/* {
        reverse_proxy https://us.i.posthog.com:443 {
            header_up Host us.i.posthog.com
            header_up -Cookie
            header_up -Authorization
        }
    }

    # `trailingSlash: true` means routes are exported as <path>/index.html.
    try_files {path} {path}/index.html {path}.html
    file_server

    # Serve the static 404 page with a real 404 status (avoids SEO soft-404s)
    # instead of falling back to index.html like an SPA would.
    handle_errors {
        rewrite * /404.html
        file_server
    }
}

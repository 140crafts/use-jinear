{
debug
on_demand_tls {
        ask http://localhost:1100/v1/domain/validate
    }
}

http://localhost:1100 {
    bind 127.0.0.1

    route /v1/domain/validate {
        reverse_proxy http://jinear-core:8008 {
            header_up Host api.jinear.co
            #Spin up your jinear instance. Login get your jwt from devtools.
            #go to jwt.io change ROLE_USER with ROLE_DOMAINSERVER and sign
            #with your signin key and put here
            header_up Authorization "Bearer EDITED_TOKEN_HERE"
        }
    }
}

https://jinear.cagdastunca.com {
    tls {
        issuer acme
    }
    reverse_proxy {
        to http://jinear-web:3000
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

https://api.jinear.cagdastunca.com {
    tls {
        issuer acme
    }
    reverse_proxy {
        to http://jinear-core:8008
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

https://files.jinear.cagdastunca.com {
    tls {
        issuer acme
    }
    reverse_proxy {
        to http://jinear-minio:9000
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}


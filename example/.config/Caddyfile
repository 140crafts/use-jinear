{
debug
on_demand_tls {
        ask http://localhost:1100/v1/domain/validate
    }
}

http://localhost:1100 {
    bind 127.0.0.1

    route /v1/domain/validate {
        reverse_proxy http://jinear-core:8008 {
            header_up Host api.jinear.co
            # This should be a JWT signed with your JWT_SECRET using HS512 algorithm
            # with "authorities": ["ROLE_DOMAINSERVER"] in the payload.
            # The install script generates this automatically.
            # For manual setup: create JWT at jwt.io with your JWT_SECRET
            header_up Authorization "Bearer YOUR_JWT_TOKEN_HERE"
        }
    }
}

https://jinear.cagdastunca.com {
    tls {
        issuer acme
    }
    reverse_proxy {
        to http://jinear-web:3000
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

https://api.jinear.cagdastunca.com {
    tls {
        issuer acme
    }
    reverse_proxy {
        to http://jinear-core:8008
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

https://files.jinear.cagdastunca.com {
    tls {
        issuer acme
    }

    # Handle all methods
    @all {
        method GET POST PUT DELETE HEAD OPTIONS
    }

    reverse_proxy @all {
        to http://jinear-minio:9000
        header_up Host {upstream_hostport}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Preserve original headers
        header_up -X-Forwarded-Host
    }
}

https://message.jinear.cagdastunca.com {
    tls {
        issuer acme
    }
    reverse_proxy {
        to http://jinear-message:3001
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
        header_up X-Forwarded-For {http.reverse_proxy.upstream.address}
        header_up X-Forwarded-Proto {scheme}

        # WebSocket support
        header_up Connection {>Connection}
        header_up Upgrade {>Upgrade}
    }
}


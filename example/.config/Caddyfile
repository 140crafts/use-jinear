# Catch-all for custom project domains - these WILL be validated via /v1/domain/validate
:443 {
    tls {
        on_demand
    }
    reverse_proxy https://pages.jinear.cagdastunca.com {
        header_up Host pages.jinear.cagdastunca.com
    }
}
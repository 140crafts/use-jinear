<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet author="cagdas.tunca" id="jinear-538-initialize-material">
        <createTable tableName="material">
            <column name="material_id" type="char(26)">
                <constraints nullable="false" primaryKey="true" unique="true"/>
            </column>
            <column name="idate" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="udate" type="datetime"/>
            <column name="passive_id" type="char(26)"/>
            <column name="workspace_id" type="char(26)">
                <constraints nullable="false"/>
            </column>
            <column name="owner_id" type="char(26)">
                <constraints nullable="false"/>
            </column>
            <column name="parent_material_id" type="char(26)"/>
            <column name="media_id" type="char(26)"/>
            <column name="material_type" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="icon" type="varchar(255)"/>
            <column name="color" type="char(6)"/>
        </createTable>

        <createIndex indexName="material_ix_workspace_id" tableName="material">
            <column name="workspace_id"/>
        </createIndex>
        <createIndex indexName="material_ix_owner_id" tableName="material">
            <column name="owner_id"/>
        </createIndex>
        <createIndex indexName="material_ix_parent_material_id" tableName="material">
            <column name="parent_material_id"/>
        </createIndex>
        <createIndex indexName="material_ix_media_id" tableName="material">
            <column name="media_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="cagdas.tunca" id="jinear-504-add-material_access_type-to-material">
        <addColumn tableName="material">
            <column name="material_access_type" type="int" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet author="cagdas.tunca" id="jinear-538-initialize-material_access">
        <createTable tableName="material_access">
            <column name="material_access_id" type="char(26)">
                <constraints nullable="false" primaryKey="true" unique="true"/>
            </column>
            <column name="idate" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="udate" type="datetime"/>
            <column name="passive_id" type="char(26)"/>
            <column name="material_id" type="char(26)">
                <constraints nullable="false"/>
            </column>
            <column name="account_id" type="char(26)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>

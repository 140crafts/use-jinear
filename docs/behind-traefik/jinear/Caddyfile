{
    debug
    auto_https off
    servers {
        trusted_proxies static private_ranges
    }
}

http://jinear.example.com {
    reverse_proxy http://jinear-app:80
}

http://api.jinear.example.com {
    reverse_proxy http://jinear-core:8008 {
        header_up X-Real-IP {client_ip}
        header_up X-Forwarded-For {client_ip}
        header_up X-Forwarded-Proto {scheme}
    }
}

http://files.jinear.example.com {
    # User uploads are served from this origin. Block scripts so an uploaded HTML or
    # SVG file cannot run code. `sandbox` is not used: it can break the browser PDF viewer.
    header {
        X-Content-Type-Options "nosniff"
        Content-Security-Policy "script-src 'none'"
    }

    reverse_proxy http://jinear-minio:9000
}

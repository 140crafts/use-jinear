{
debug

# Use Let's Encrypt production server (not staging)
acme_ca https://acme-v02.api.letsencrypt.org/directory
}

https://jinear.cagdastunca.com {
    reverse_proxy {
        to http://jinear-app:80
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

https://api.jinear.cagdastunca.com {
    reverse_proxy {
        to http://jinear-core:8008
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

https://files.jinear.cagdastunca.com {
    # Handle all methods
    @all {
        method GET POST PUT DELETE HEAD OPTIONS
    }

    reverse_proxy @all {
        to http://jinear-minio:9000
        header_up Host {upstream_hostport}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Preserve original headers
        header_up -X-Forwarded-Host
    }
}

# -----------------------------------------------------------------------------
# DOMAIN CONFIGURATION
# -----------------------------------------------------------------------------
# Your main application domain (e.g., jinear.company.com)
DOMAIN=jinear.example.com

# API subdomain - typically api.{DOMAIN}
API_DOMAIN=api.jinear.example.com

# File storage subdomain - typically files.{DOMAIN}
FILES_DOMAIN=files.jinear.example.com

# -----------------------------------------------------------------------------
# TIMEZONE
# -----------------------------------------------------------------------------
TIMEZONE=Europe/Istanbul

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Auto-generated - DO NOT SHARE)
# -----------------------------------------------------------------------------
POSTGRES_DB=jinear
POSTGRES_USER=jinear_user
POSTGRES_PASSWORD=GENERATED_DB_PASSWORD

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION (Auto-generated - DO NOT SHARE)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=GENERATED_REDIS_PASSWORD

# -----------------------------------------------------------------------------
# MINIO (S3-Compatible Storage) CONFIGURATION
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=jinear_minio
MINIO_ROOT_PASSWORD=GENERATED_MINIO_PASSWORD

# -----------------------------------------------------------------------------
# SECURITY SECRETS (Auto-generated - DO NOT SHARE)
# -----------------------------------------------------------------------------
JWT_SECRET=GENERATED_JWT_SECRET
ENCRYPTOR_PASSWORD=GENERATED_ENCRYPTOR_PASSWORD

# -----------------------------------------------------------------------------
# INTERNAL SERVICE AUTHENTICATION
# -----------------------------------------------------------------------------
INTERNAL_AUTH_TOKEN=GENERATED_INTERNAL_AUTH_TOKEN

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (Optional - configure for email notifications)
# -----------------------------------------------------------------------------
# SMTP Configuration
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER_ADDRESS=noreply@example.com

# -----------------------------------------------------------------------------
# ANALYTICS (Optional)
# -----------------------------------------------------------------------------
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# BACKUP CONFIGURATION
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# ADVANCED CONFIGURATION
# -----------------------------------------------------------------------------
# Only modify if you know what you're doing

# Rate limiting
RATE_LIMIT_PUBLIC_CAPACITY=25
RATE_LIMIT_AUTH_CAPACITY=100

# -----------------------------------------------------------------------------
# APPLE SIGN IN (Optional - configure for Sign In with Apple)
# -----------------------------------------------------------------------------
# Set to true to enable Sign In with Apple. When false (default) the Apple beans
# are not created, so the .p8 key file below is NOT required and jinear-core boots
# without it. To enable: set this to true, fill the values below, and mount your
# AuthKey.p8 into the .config/ directory (so it resolves to APPLE_KEY_PATH).
APPLE_ENABLED=false
# Apple Developer Team ID
APPLE_TEAM_ID=
# Apple Key ID (from Apple Developer Portal)
APPLE_KEY_ID=
# Path to the .p8 private key file inside the container
APPLE_KEY_PATH=/config/AuthKey.p8
# Mobile app bundle ID (e.g., co.yourcompany.app)
APPLE_CLIENT_ID=
# Web Service ID (e.g., co.yourcompany.app.web)
APPLE_WEB_CLIENT_ID=
# Redirect URL registered in Apple Developer Portal
APPLE_WEB_REDIRECT_URL=https://your-domain.com
# Frontend: Apple Web Service ID (shown in Sign In with Apple button)
NEXT_PUBLIC_APPLE_CLIENT_ID=
# Frontend: Redirect URI for Apple Sign In callback
NEXT_PUBLIC_APPLE_REDIRECT_URI=https://your-domain.com

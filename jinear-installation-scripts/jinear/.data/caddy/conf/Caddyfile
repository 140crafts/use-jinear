{
    debug
    on_demand_tls {
        ask http://localhost:1100/v1/domain/validate
    }
}

http://localhost:1100 {
    bind 127.0.0.1

    route /v1/domain/validate {
        reverse_proxy http://jinear-core:8008 {
            header_up Host api.j.j.com
            header_up Authorization "Bearer Ll9O9s9j36gojYMpZxiCupj0hG6SkSGh0MiWHyIbEyRXUNjfIuPSK4y7e9bMGKeL"
        }
    }
}

https://j.j.com {
    tls {
        on_demand
    }
    reverse_proxy {
        to http://jinear-web:3000
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

https://api.j.j.com {
    tls {
        on_demand
    }
    reverse_proxy {
        to http://jinear-core:8008
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

https://files.j.j.com {
    tls {
        on_demand
    }
    reverse_proxy {
        to http://jinear-minio:9000
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

https://pages.j.j.com {
    tls {
        on_demand
    }
    reverse_proxy {
        to http://jinear-pages:3000
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

:443 {

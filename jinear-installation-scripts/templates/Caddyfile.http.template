{
    auto_https off
}

http://__DOMAIN__ {
    reverse_proxy {
        to http://jinear-app:80
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

http://__API_DOMAIN__ {
    reverse_proxy {
        to http://jinear-core:8008
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

http://__FILES_DOMAIN__ {
    @all {
        method GET POST PUT DELETE HEAD OPTIONS
    }

    reverse_proxy @all {
        to http://jinear-minio:9000
        # Preserve the original Host (files domain) so it matches the SigV4-signed host on
        # presigned URLs. Rewriting Host to the upstream service name breaks uploads/downloads (403).
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Preserve original headers
        header_up -X-Forwarded-Host
    }
}

jasypt.encryptor.bean=encryptorBean

spring.application.name=jinear-core
server.port=8008
server.http2.enabled=true

spring.jackson.default-property-inclusion=non_null

logging.level.*=INFO
logging.file.path=./logs/
logging.file.name=./logs/app.log
logging.pattern.level=%5p [${spring.application.name:},%X{traceId:-},%X{spanId:-}]

server.servlet.encoding.charset=UTF-8
server.servlet.encoding.enabled=true
server.servlet.encoding.force=true

jwt.secret=${JWT_SECRET}
jwt.include-domain=true
jwt.domain=${JWT_DOMAIN}
jwt.include-same-site=true
jwt.same-site=None
jwt.is-secure=true
jwt.messaging.secret=ignore-me

spring.servlet.multipart.maxFileSize=1999MB
spring.servlet.multipart.maxRequestSize=1999MB

# ===================================================================
# CORS Configuration
# ===================================================================
cors.allow-credentials=true
cors.allowed-methods=GET,POST,PUT,DELETE
cors.allowed-origin-patterns=${CORS_ORIGINS:*}

# ===============================
# = DATA SOURCE REDIS
# ===============================
spring.data.redis.host=jinear-redis
spring.data.redis.password=${REDIS_PASSWORD}
spring.data.redis.timeout=60000
spring.data.redis.ssl=false
spring.data.redis.port=6379

# ===============================
# = DATA SOURCE
# ===============================
spring.datasource.url=jdbc:postgresql://jinear-db:5432/${POSTGRES_DB:jinear}
spring.datasource.username=${POSTGRES_USER}
spring.datasource.password=${POSTGRES_PASSWORD}
spring.datasource.driverClassName=org.postgresql.Driver
spring.datasource.tomcat.validation-query=SELECT 1
spring.datasource.tomcat.test-on-borrow=true
spring.datasource.tomcat.validation-interval=10000
spring.jpa.properties.hibernate.naming-strategy=org.hibernate.cfg.ImprovedNamingStrategy
spring.jpa.properties.hibernate.globally_quoted_identifiers=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto = none
spring.jpa.properties.hibernate.enable_lazy_load_no_trans=true
spring.jpa.show-sql=false

spring.liquibase.enabled=true
spring.liquibase.change-log=classpath:db/changelog/changelog-master.xml
spring.liquibase.liquibaseSchema=public
spring.liquibase.defaultSchema=public

# ==============================================================
# = Spring-boot-starter-mail
# ==============================================================
spring.mail.host=${MAIL_HOST:localhost}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.sender-address=${MAIL_SENDER_ADDRESS:noreply@example.com}
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000
spring.mail.properties.mail.smtp.socketFactory.port=465
spring.mail.properties.mail.smtp.socketFactory.class=javax.net.ssl.SSLSocketFactory

# ==============================================================
# = Generic
# ==============================================================
jinear.remove-pricing=true
jinear.security.rate-limit.client-ip-header=X-Forwarded-For
jinear.security.rate-limit.plans.public.capacity=${RATE_LIMIT_PUBLIC_CAPACITY:25}
jinear.security.rate-limit.plans.public.duration-in-minutes=1
jinear.security.rate-limit.plans.public.refillType=intervally
jinear.security.rate-limit.plans.authenticated.capacity=${RATE_LIMIT_AUTH_CAPACITY:100}
jinear.security.rate-limit.plans.authenticated.duration-in-minutes=1
jinear.security.rate-limit.plans.authenticated.refillType=greedy
jinear.storage.limit.basic=1024
jinear.storage.limit.pro=204800
# ==============================================================
# = GCloud (Optional - leave as-is if not using Google services)
# ==============================================================
gcloud.projectId=not-configured
gcloud.cloudStorage.bucketName=not-configured
gcloud.cloudStorage.base-path=not-configured
gcloud.oauth.baseUrl=https://oauth2.googleapis.com
gcloud.oauth.clientId=not-configured
gcloud.oauth.clientSecret=not-configured
gcloud.oauth.redirect-url.login=${FE_PATH}/v1/oauth/google/callback/login
gcloud.oauth.redirect-url.attach-mail=${FE_PATH}/v1/oauth/google/callback/attach-mail
gcloud.oauth.redirect-url.attach-calendar=${FE_PATH}/v1/oauth/google/callback/attach-calendar
google.apis.baseUrl=https://www.googleapis.com/
google.apis.gmail.baseUrl=https://gmail.googleapis.com/gmail/

# ==============================================================
# = MinIO
# ==============================================================
minio.base-path=${MINIO_BASE_PATH}
minio.private-bucket-name=jinear-b0-private
minio.public-bucket-name=jinear-b0-public
minio.endpoint=${MINIO_ROOT}
minio.key=${MINIO_KEY}
minio.secret=${MINIO_SECRET}

# ==============================================================
# = SLACK (Optional)
# ==============================================================
slack.token=ignore-me
slack.monitoring.impl=mock

# ===============================
# = FE
# ===============================
fe.email-confirmation-url=${FE_PATH}/engage/confirm-email?token={token}
fe.password-reset-url=${FE_PATH}/engage/reset-password-complete?token={token}
fe.task-url=${FE_PATH}/{workspaceName}/task/{taskTag}
fe.workspace-invitation-url=${FE_PATH}/engage/workspace-invitation?token={token}
fe.home-url=${FE_PATH}/home
fe.workspace-calendar-url=${FE_PATH}/{workspaceUsername}/calendar
fe.account-delete-url=${FE_PATH}/engage/delete-account-complete?token={token}

# ===============================
# = NOTIFICATIONS
# ===============================
notification.onesignal.appId=not-configured
notification.onesignal.userKeyToken=not-configured
notification.firebase.enabled=false
notification.firebase.auth=d2hhdHVw

# ===============================
# = Payment Processor
# ===============================
payment-processor.url=https://payments.com
payment-processor.security.key=ignore
payment-processor.security.secret=ignore
payment-processor.mock=true

# ===============================
# = SSE
# ===============================
sse.latest-activity.interval=60

# ===============================
# = MOCK
# ===============================
mock.google-auth-client.enabled=false
mock.google-apis-client.enabled=false
mock.gmail-client.enabled=false
mock.expo-push-notification=false
mock.axiom=true
mock.message-api-client.enabled=false

# ===============================
# = EXPO (Optional)
# ===============================
expo.token=not-configured
expo.push-notification.url=https://exp.host/--/api

# ===============================
# = AXIOM (Optional)
# ===============================
axiom.token=not-configured
axiom.dataset=jinear_be
axiom.url=https://api.axiom.co/v1

# ===============================
# = MESSAGE-API
# ===============================
message-api.endpoint=http://jinear-message-api
message-api.token=${INTERNAL_AUTH_TOKEN}

# ===============================
# = FILE-STORAGE
# ===============================
file-storage.active=MINIO
file-storage.minio.enabled=true
file-storage.explicit-content-check-enabled=false


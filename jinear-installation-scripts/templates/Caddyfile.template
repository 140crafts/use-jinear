{
    debug
    on_demand_tls {
        ask http://localhost:1100/v1/domain/validate
    }
}

http://localhost:1100 {
    bind 127.0.0.1

    route /v1/domain/validate {
        reverse_proxy http://jinear-core:8008 {
            header_up Host api.__DOMAIN__
            header_up Authorization "Bearer __CADDY_VALIDATION_TOKEN__"
        }
    }
}

https://__DOMAIN__ {
    tls {
        issuer acme
    }
    reverse_proxy {
        to http://jinear-web:3000
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

https://__API_DOMAIN__ {
    tls {
        issuer acme
    }
    reverse_proxy {
        to http://jinear-core:8008
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

https://__FILES_DOMAIN__ {
    tls {
        issuer acme
    }
    reverse_proxy {
        to http://jinear-minio:9000
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

https://__PAGES_DOMAIN__ {
    tls {
        issuer acme
    }
    reverse_proxy {
        to http://jinear-pages:3000
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

# Catch-all for custom project domains - these WILL be validated via /v1/domain/validate
:443 {
    tls {
        on_demand
    }
    reverse_proxy https://__PAGES_DOMAIN__ {
        header_up Host __PAGES_DOMAIN__
    }
}


{
    debug

    # Use Let's Encrypt production server (not staging)
    acme_ca https://acme-v02.api.letsencrypt.org/directory

    # On-demand TLS validation - only applies to sites using "tls { on_demand }"
    on_demand_tls {
        ask http://localhost:1100/v1/domain/validate
    }
}

# Internal endpoint for on-demand TLS validation (custom domains only)
http://localhost:1100 {
    bind 127.0.0.1

    route /v1/domain/validate {
        reverse_proxy http://jinear-core:8008 {
            header_up Host api.__DOMAIN__
            header_up Authorization "Bearer __CADDY_VALIDATION_TOKEN__"
        }
    }
}

# Known domains - explicit hostnames take precedence over catch-all :443
# These use standard ACME (automatic) and do NOT trigger on_demand_tls validation
https://__DOMAIN__ {
    reverse_proxy {
        to http://jinear-web:3000
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

https://__API_DOMAIN__ {
    reverse_proxy {
        to http://jinear-core:8008
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

https://__FILES_DOMAIN__ {
    # Handle all methods
    @all {
        method GET POST PUT DELETE HEAD OPTIONS
    }

    reverse_proxy @all {
        to http://jinear-minio:9000
        header_up Host {upstream_hostport}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Preserve original headers
        header_up -X-Forwarded-Host
    }
}

https://__PAGES_DOMAIN__ {
    reverse_proxy {
        to http://jinear-pages:3000
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
    }
}

https://__MESSAGE_DOMAIN__ {
    # WebSocket and HTTP reverse proxy
    reverse_proxy http://jinear-message:3001 {
        # Preserve headers for WebSocket upgrade
        header_up Host {http.reverse_proxy.upstream.host}
        header_up X-Real-IP {http.reverse_proxy.upstream.address}
        header_up X-Forwarded-For {http.reverse_proxy.upstream.address}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Catch-all for custom project domains
# This ONLY matches domains not explicitly defined above
# The "on_demand" here triggers the global on_demand_tls validation
:443 {
    tls {
        on_demand
    }
    reverse_proxy https://__PAGES_DOMAIN__ {
        header_up Host __PAGES_DOMAIN__
    }
}


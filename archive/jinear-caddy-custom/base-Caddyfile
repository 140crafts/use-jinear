{
    debug
    admin 0.0.0.0:2019
    on_demand_tls {
            ask http://localhost:9000/v1/domain/validate
        }
}

https://*.projects.jinear.co {
    tls {
        dns cloudflare ABCDE
    }

    reverse_proxy https://pages.jinear.co {
        header_up Host pages.jinear.co
    }
}

http://localhost:9000 {
    bind 127.0.0.1

    route /v1/domain/validate {
        reverse_proxy https://api.jinear.co {
            header_up Host api.jinear.co
            header_up Authorization "Bearer JWT_WITH_ROLE_DOMAINSERVER"
        }
    }
}

:443 {
    tls {
        on_demand
    }
    reverse_proxy https://pages.jinear.co {
        header_up Host pages.jinear.co
    }
}
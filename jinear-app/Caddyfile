# Plain HTTP on :80. TLS is expected to be terminated by an upstream
# reverse proxy / load balancer / ingress, not by this container.

:80 {
    root * /srv
    encode zstd gzip

    # Hashed assets (Vite emits /assets/<name>-<hash>.<ext>), safe to cache forever.
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # index.html references the current bundle hashes and MUST refresh every deploy.
    @html {
        path /
        path *.html
    }
    header @html Cache-Control "no-cache"

    # Service worker + PWA manifest must not be cached, or env-var changes after
    # a redeploy never reach already-installed clients. (The SW registration is
    # inlined into index.html via vite-plugin-pwa, so there is no /registerSW.js.)
    @sw path /sw.js /manifest.webmanifest
    header @sw Cache-Control "no-cache"

    # The app is authenticated and nothing here should be indexed. The SPA fallback
    # below returns index.html for EVERY path, which otherwise exposes an unbounded
    # set of identical pages (same title, same description) to crawlers. Sent as a
    # header rather than relying on the <meta> tag alone so it also covers crawlers
    # that don't execute JS and non-HTML responses.
    header X-Robots-Tag "noindex, nofollow"

    # SPA fallback, any unknown path serves index.html so the React router can handle it.
    try_files {path} /index.html
    file_server
}

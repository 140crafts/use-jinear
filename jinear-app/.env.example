# Schema for runtime-configurable env vars.
# At container start, the docker entrypoint runs `import-meta-env` which reads
# these names from the real process env and rewrites their placeholders in dist/.
# List every runtime variable here. Values in this file are NOT used — only the keys are.

# Origin of the Jinear backend API. Self-hosters set this to their own URL.
# Examples: https://api.example.com  or  http://localhost:8085
VITE_API_URL=https://api.jinear.co

# Public origin of this web app itself (used to build absolute links).
# Self-hosters set this to the domain they serve the frontend on.
# Examples: https://app.example.com  or  http://localhost:5173
VITE_HOST=https://jinear.co

# Apple Sign In. Set these only if you enable "Sign in with Apple"; they must
# match your Apple Service ID and its configured return URL.
VITE_APPLE_CLIENT_ID=APPLE_CLIENT_ID
VITE_APPLE_REDIRECT_URI=APPLE_REDIRECT_URI

# Firebase Web app config for Cloud Messaging (web push). Used by both the app
# bundle and the service worker (src/sw.ts). Self-hosters that want push must
# set these to their own Firebase project; the VAPID key is the Web Push
# certificate key pair from Firebase Console > Cloud Messaging.
# Like every key here, these are REQUIRED at container start.
VITE_FIREBASE_API_KEY=FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=FIREBASE_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=FIREBASE_MEASUREMENT_ID
VITE_FIREBASE_VAPID_KEY=FIREBASE_VAPID_KEY
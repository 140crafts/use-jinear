# Schema for runtime-configurable env vars.
# At container start, the docker entrypoint runs `import-meta-env` which reads
# these names from the real process env and rewrites their placeholders in dist/.
# List every runtime variable here. Values in this file are NOT used — only the keys are.

# Origin of the Jinear backend API. Self-hosters set this to their own URL.
# Examples: https://api.example.com  or  http://localhost:8085
VITE_API_URL=https://api.jinear.co